# ================= SFTP =================
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USERNAME=sftp_user
SFTP_PASSWORD=
# Optional: SSH private key in OpenSSH format (convert a PuTTY .ppk with puttygen, see README).
# Used alone (key-only login) or with SFTP_PASSWORD (password + key, e.g. SBI GoAnywhere)
SFTP_PRIVATE_KEY=
SFTP_PRIVATE_KEY_PASSPHRASE=
# Optional: answer for the keyboard-interactive prompt after the password (default = SFTP_PASSWORD)
SFTP_INTERACTIVE_RESPONSE=
# Optional: fixed login order for key + password servers, e.g. publickey,password
# (empty = publickey,keyboard-interactive,password; one login attempt per run)
SFTP_LOGIN_ORDER=
# Remote file. {date:%d%m%Y} is replaced by today's date (e.g. 05102026) on every run;
# POST /process-file?file_date=2026-10-03 processes the file of another day.
SFTP_REMOTE_FILE=/incoming/customer_data_{date:%d%m%Y}.csv.gpg
# Time zone used for "today" (server clocks are UTC). +05:30 = India
SFTP_DATE_UTC_OFFSET=+05:30
# Host key verification (protects against man-in-the-middle attacks)
SFTP_KNOWN_HOSTS=~/.ssh/known_hosts
SFTP_STRICT_HOST_KEY_CHECKING=true
SFTP_TIMEOUT_SECONDS=30
SFTP_MAX_FILE_MB=200

# ================= GPG =================
GPG_PASSPHRASE=
# Optional: separate keyring folder (leave empty to use ~/.gnupg)
GPG_HOME=
# Text encoding of the decrypted file
FILE_ENCODING=utf-8-sig

# ================= Dialer MySQL =================
DIALER_DB_HOST=127.0.0.1
DIALER_DB_PORT=3306
DIALER_DB_USER=dialer_import
DIALER_DB_PASSWORD=
DIALER_DB_NAME=dialer
DIALER_TARGET_TABLE=customer_leads
HISTORY_TABLE=sftp_file_history

# ================= VICIdial (optional second DB) =================
# If VICIDIAL_DB_HOST is set, every saved record is also inserted as a lead into
# VICIDIAL_TABLE (mapping: LEAD_MAPPING in app/vicidial_db.py). Empty = off.
VICIDIAL_DB_HOST=
VICIDIAL_DB_PORT=3306
VICIDIAL_DB_USER=
VICIDIAL_DB_PASSWORD=
VICIDIAL_DB_NAME=asterisk
VICIDIAL_TABLE=vicidial_list
VICIDIAL_LIST_ID=5001
VICIDIAL_PHONE_CODE=1
VICIDIAL_GMT_OFFSET=5.50

# ================= App =================
# preview = authenticate + decrypt + read CSV + PRINT to console (no DB)
# save    = full flow, insert into Dialer DB
PROCESS_MODE=preview
# Rows printed in preview mode (0 = print all rows)
PREVIEW_ROWS=20
# Optional: if set, POST /process-file and GET /history need header X-API-Key
API_KEY=
LOG_LEVEL=INFO
# Optional: also write logs to this file, e.g. app.log
LOG_FILE=
